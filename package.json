{
  "name": "audiofit-monorepo",
  "version": "1.0.0",
  "description": "AudioFit - A mobile fitness app with music integration",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:preview": "cd frontend && npm run preview",
    "backend:setup": "cd backend && python -m venv venv && .\\venv\\Scripts\\activate && pip install -r requirements.txt",
    "backend:dev": "cd backend && python manage.py runserver",
    "backend:migrate": "cd backend && python manage.py migrate",
    "backend:createsuperuser": "cd backend && python manage.py createsuperuser",
    "dev": "npm run frontend:dev",
    "build": "npm run frontend:build"
  },
  "keywords": [
    "fitness",
    "music",
    "mobile",
    "react"
  ],
  "author": "",
  "license": "MIT"
}
